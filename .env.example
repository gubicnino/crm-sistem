# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Neon Postgres connection string (serverless driver, HTTP-based — see db/index.ts)
DATABASE_URL="postgresql://user:password@ep-example-12345.region.aws.neon.tech/neondb?sslmode=require"

# Auth.js v5 — generate with `npx auth secret`
AUTH_SECRET=""

# Resend (transactional + scheduled sequence emails)
# MUST be a "Full access" API key, not "Sending access" — this app calls
# resend.emails.cancel() to cancel a lead's remaining sequence on conversion/
# unsubscribe (see lib/email/cancel.ts), which a send-only key cannot do
# (verified live: it returns a 401 `restricted_api_key` error, not a
# cancel-specific one). A send-only key will silently break cancellation.
RESEND_API_KEY=""
# Requires a domain verified in the Resend dashboard. For local dev without
# one, use the zero-setup sender "onboarding@resend.dev" — it works
# immediately but is rate-limited and meant for testing only.
RESEND_FROM_EMAIL="Trener Growth Sistem <noreply@yourdomain.com>"

# Bearer token Vercel Cron sends as `Authorization: Bearer $CRON_SECRET`.
# Generate with e.g. `openssl rand -hex 32`.
CRON_SECRET=""

# Used to build absolute links in emails (unsubscribe, password reset, invites).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
